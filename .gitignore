# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be tracked. A gitignored-only .env is exactly how
# the recurring cross-session desync on the risk watch-list happens.
!.env.example

# leo / aleo build artifacts
program/build/
program/outputs/
*.prover
*.verifier

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
