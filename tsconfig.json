{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // services/ is a separate Node app with its own tsconfig (module: NodeNext).
  // Type-checking it here applies this config's bundler/DOM resolution, under
  // which @provablehq/sdk resolves to its browser target and LocalFileKeyStore
  // appears not to exist — the same ambiguity that forced a ts-expect-error in
  // the old serverless route.
  "exclude": ["node_modules", "services"]
}
