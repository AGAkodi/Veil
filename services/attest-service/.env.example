# Veil attest service — copy to .env for local runs, or set these in the
# Railway/Render dashboard for the deployed service.
#
# Keep this template in sync when adding a variable. A variable that exists
# only in someone's local .env is the desync failure on the risk watch-list —
# and it already bit this project once.

# --- Required -------------------------------------------------------------

# The oracle signing key. submit_attestation is gated to ORACLE_ADDRESS in the
# Leo program, so this must be the key for
# aleo15m50rvhx0glq0hjv807c2t0z40et9ljmvdjrqv8f4pr8evzs2qysfnv2un.
# Testnet only. This is the ONLY place it should live once the split is done —
# remove it from Vercel.
ORACLE_PRIVATE_KEY=

# Comma-separated list of origins allowed to call /attest. No wildcards: this
# endpoint spends real credits. Include the Vercel production URL, and
# http://localhost:3000 while developing.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# --- Optional -------------------------------------------------------------

# Injected automatically by Railway/Render. Defaults to 8080 locally.
PORT=8080

ALEO_ENDPOINT=https://api.explorer.provable.com/v1
PROGRAM_ID=veil_attest_v2.aleo

# Priority fee in credits for the public execution fee.
PRIORITY_FEE=0.0035

# Optional shared header check between the frontend and this service. Set the
# same value as NEXT_PUBLIC_ATTEST_SHARED_SECRET on Vercel.
#
# Be clear-eyed about this: the frontend calls this endpoint directly from the
# browser, so the value ships to every visitor. It deters casual callers who
# find the URL; it is NOT authentication. The rate limiter is the real guard.
ATTEST_SHARED_SECRET=
