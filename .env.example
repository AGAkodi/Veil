# Veil Environment Variables Example
# Copy this file to .env and configure the values.

# --- Aleo Network -------------------------------------------------------------
ALEO_ENDPOINT=https://api.explorer.provable.com/v1
NETWORK=testnet
PROGRAM_ID=veil_attest_v2.aleo

# --- Frontend (NEXT_PUBLIC_ prefix makes these available in the browser) ----
NEXT_PUBLIC_ALEO_ENDPOINT=https://api.explorer.provable.com/v1
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_PROGRAM_ID=veil_attest_v2.aleo
NEXT_PUBLIC_ORACLE_ADDRESS=aleo15m50rvhx0glq0hjv807c2t0z40et9ljmvdjrqv8f4pr8evzs2qysfnv2un

# --- Attest service ----------------------------------------------------------
# Attestation is NOT served by this app. Proof generation needs a real
# filesystem, ~127 MB of proving keys, and more time than a serverless function
# gets, so it runs as a standalone Node service (services/attest-service).
#
# Point this at the deployed service, or http://localhost:8080 when running it
# locally. Without it, the Attest step fails with an explicit config error.
NEXT_PUBLIC_ATTEST_SERVICE_URL=

# Optional. Must match ATTEST_SHARED_SECRET on the attest service.
# This reaches the browser, so it is not a real secret — it only deters casual
# callers. The service's rate limiter is the actual protection.
NEXT_PUBLIC_ATTEST_SHARED_SECRET=

# --- Server-side API Keys (Strictly private — do NOT prefix with NEXT_PUBLIC_) ---
# The API key used to query the Groq LLM model for live verdicts.
GROQ_API_KEY=gsk_...YOUR_GROQ_API_KEY_HERE...

# NOTE: ORACLE_PRIVATE_KEY has moved to services/attest-service/.env.example.
# Once the split service is confirmed working, delete it from Vercel — there is
# no reason for the signing key to live on a host that no longer uses it.
