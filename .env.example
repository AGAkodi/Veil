# Copy to .env and fill in. Never commit the filled copy.
#
# Keep this template in sync whenever you add a variable — a variable that
# exists only in someone's local .env is the desync failure on the risk list.

# --- Aleo network ---------------------------------------------------------
# Testnet API endpoint used by the CLI and the frontend.
ALEO_ENDPOINT=https://api.explorer.provable.com/v1
NETWORK=testnet

# --- Deploy identity ------------------------------------------------------
# Private key for the account that deploys and executes veil.aleo.
# Testnet only. Do not put a mainnet key here.
PRIVATE_KEY=
ADDRESS=

# --- Program --------------------------------------------------------------
# Set once veil.aleo is actually deployed, not before.
PROGRAM_ID=veil.aleo

# --- Frontend -------------------------------------------------------------
# Anything the browser needs must be NEXT_PUBLIC_*. Never expose PRIVATE_KEY.
NEXT_PUBLIC_ALEO_ENDPOINT=https://api.explorer.provable.com/v1
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_PROGRAM_ID=veil.aleo
